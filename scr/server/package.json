{
  "name": "mira-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs');if(fs.existsSync('src/ml/model.json')){fs.mkdirSync('dist/ml',{recursive:true});fs.copyFileSync('src/ml/model.json','dist/ml/model.json')}\"",
    "start": "node dist/index.js",
    "seed": "tsx src/scripts/seed.ts",
    "seed:catalog": "tsx src/scripts/seed-catalog.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/bcryptjs": "^2.4.6"
  }
}
