PORT=5000
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/mira_jewelry?retryWrites=true&w=majority
# Tùy chọn khi DNS hiện tại không phân giải được MongoDB Atlas
MONGO_DNS_SERVERS=
JWT_SECRET=change_me_to_a_long_random_secret
CLIENT_URL=http://localhost:8080,http://localhost:5173

# Gemini - để trống vẫn chạy bằng bộ phân tích fallback, thêm key sau để dùng LLM thật
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# QR / Payment. QR_TEMPLATE có thể là URL của nhà cung cấp QR của m.
# Các placeholder hỗ trợ: {amount}, {content}
# Sacombank. Tên chủ tài khoản có thể bổ sung theo thông tin ngân hàng.
BANK_NAME=Sacombank
BANK_BIN=970403
BANK_ACCOUNT_NO=070126622404
BANK_ACCOUNT_NAME=
QR_TEMPLATE=
PAYMENT_WEBHOOK_SECRET=change_payment_webhook_secret

# Gmail SMTP: dùng App Password của tài khoản gửi, không dùng mật khẩu đăng nhập.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
