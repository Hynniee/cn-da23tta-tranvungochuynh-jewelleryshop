{
  "name": "mira-jewelry",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "scr/client",
    "scr/server"
  ],
  "scripts": {
    "dev": "node setup/scripts/dev-full.mjs",
    "build": "npm --workspace scr/server run build && npm --workspace scr/client run build",
    "test": "node scr/test-data/test.mjs",
    "test:decision-support": "node scr/test-data/decision-support.test.mjs",
    "test:admin-notifications": "node scr/test-data/admin-notifications.test.mjs",
    "test:cart": "node --import tsx --test scr/test-data/cart-model.test.ts",
    "test:ui": "node scr/test-data/ui-regressions.mjs",
    "test:checkout-ui": "node scr/test-data/checkout-ui.test.mjs",
    "test:account-checkout": "node scr/test-data/account-checkout.test.mjs",
    "test:uploads": "node scr/test-data/product-upload.test.mjs",
    "test:db-errors": "node scr/test-data/database-errors.test.mjs",
    "test:promotions": "node scr/test-data/promotions.test.mjs",
    "test:appointments": "node --test scr/test-data/appointments.test.mjs",
    "test:support": "node scr/test-data/support.test.mjs",
    "test:layout": "node scr/test-data/layout-audit.mjs",
    "test:inventory": "node --import tsx scr/test-data/variant-inventory.test.mjs",
    "test:sizes": "node --import tsx scr/test-data/product-sizes.test.mjs",
    "test:advisor-reset": "node scr/test-data/advisor-reset.test.mjs",
    "format": "prettier --write \"scr/**/*.{ts,tsx,css,html,json}\" \"*.json\" \"setup/scripts/*.mjs\"",
    "format:check": "prettier --check \"scr/**/*.{ts,tsx,css,html,json}\" \"*.json\" \"setup/scripts/*.mjs\"",
    "dev:full": "node setup/scripts/dev-full.mjs",
    "db:check": "node setup/scripts/check-database.mjs",
    "catalog:import": "npm --workspace scr/server run seed:catalog",
    "test:tools": "node --import tsx --test scr/test-data/personal-tools.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.0.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "smtp-server": "^3.20.2"
  }
}
